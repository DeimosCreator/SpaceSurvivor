  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u0434\u0438\u043D \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A,
    \u043A\u043E\u0444\u0435 \u0438 \u0431\u0435\u0441\u0441\u043E\u043D\u043D\u0430\u044F
    \u043D\u043E\u0447\u044C \u2014 \u0442\u0430\u043A \u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044C
    \u044D\u0442\u0430 \u0438\u0433\u0440\u0430.\n\u0422\u0443\u0442 \u0432\u044B
    \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442\u0435, \u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C,
    \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u0434\u0435\u0442\u0430\u043B\u0438
    \u0438 \u043F\u044B\u0442\u0430\u0435\u0442\u0435\u0441\u044C \u043D\u0435 \u0432\u0437\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F.\n\u0415\u0441\u043B\u0438
    \u0432\u0435\u0441\u0435\u043B\u043E \u2014 \u0446\u0435\u043B\u044C \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u0430.
    \u0410 \u0435\u0441\u043B\u0438 \u043D\u0435 \u0432\u0435\u0441\u0435\u043B\u043E...
    \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451
    \u0440\u0430\u0437)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7c3083dc5d022c447a86b9b8368963c4, type: 2}
